# ---- AI ----
ANTHROPIC_API_KEY=
# Model used by the voice agent. Fast + accurate tool use required.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ConversationRelay voice defaults (overridable per-restaurant in Admin > Voice)
# Browser test-calls (Admin > Call from browser): create with
# POST /2010-04-01/Accounts/{sid}/Keys.json and Applications.json
# (the app's VoiceUrl points at the same /twilio/voice webhook).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

TWILIO_TTS_PROVIDER=Google
TWILIO_TTS_VOICE=en-AU-Neural2-A
TWILIO_STT_PROVIDER=Deepgram

# ---- Database ----
# Local dev uses Docker Postgres (docker compose up -d postgres).
# For Supabase, paste the Supabase connection string here instead.
DATABASE_URL=postgres://meatbox:meatbox_dev_password@127.0.0.1:5441/meatbox
TEST_DATABASE_URL=postgres://meatbox:meatbox_dev_password@127.0.0.1:5441/meatbox_test

# Supabase (optional — used when deploying on Supabase instead of plain Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Notifications ----
OWNER_NOTIFICATION_PHONE=
# live = really send SMS via Twilio; log = record + log only (safe default for dev)
SMS_MODE=log

# ---- n8n integration (optional) ----
# Order events (order.confirmed / order.needs_review / owner_sms_failed) are
# POSTed here, signed with X-Meatbox-Signature (HMAC-SHA256 of the body).
# Import n8n-meatbox-workflow.json into n8n and paste the secret there too.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---- Square (optional) ----
# Create an app at developer.squareup.com, then Admin > Integrations > Connect.
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=production
# Webhook signature key from the Square app's Webhooks page (Terminal events).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Paired Square Terminal device id (required for PAYMENTS_PROVIDER=square_terminal).
SQUARE_TERMINAL_DEVICE_ID=

# ---- Payments (Phase 3) ----
# mock_terminal = explicit TEST terminal (badged in the kiosk UI, no real money).
# square_terminal = real Square Terminal checkouts (needs Square connected + device).
PAYMENTS_PROVIDER=mock_terminal
# Mock terminal behaviour for demos/UAT: approve | decline, after N seconds.
MOCK_TERMINAL_BEHAVIOUR=approve
MOCK_TERMINAL_DELAY_SECONDS=4

# ---- URLs ----
APP_URL=http://127.0.0.1:4810
# Public wss:// URL Twilio connects to (tunnel or deployed voice service)
VOICE_WEBSOCKET_URL=ws://127.0.0.1:4811/twilio/relay
# Public https:// base of the voice service (for Twilio webhooks)
VOICE_PUBLIC_URL=http://127.0.0.1:4811

# ---- Service ports (loopback in dev) ----
WEB_PORT=4810
VOICE_PORT=4811
HOST=127.0.0.1

# ---- Auth ----
# 32+ random bytes, base64/hex. Used to sign session cookies.
SESSION_SECRET=

# ---- Monitoring ----
SENTRY_DSN=

# ---- Internal ----
# Shared secret between the web app and the voice service (simulator, admin ops)
INTERNAL_API_SECRET=
